<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
</head>
<body>
    <header>
        <h1> <%= title %></h1>
    </header>
    <ul>
        <% messages.forEach( m => { %>
            <li>
                <article>
                    <h2>
                        <%= m.user %>
                    </h2>
                    <h3>
                        <%= m.text %>
                    </h3>
                    <p>
                        <%= m.added %>
                    </p>
                </article>
            </li>
        <% }) %>
    </ul>
    <%- include('form') %>
</body>
</html>