<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/styles.css">
</head>
<body>
    <header>
        <h1> <%= title %></h1>
    </header>
    <ul>
        <% messages.forEach( m => { %>
            <li>
                <article>
                    <div class="user-info">
                        <img src="<%= m.image %>" alt="<%= m.user %>">
                        <h2>
                            <%= m.user %>
                        </h2>
                    </div>
                    <h3>
                        <%= m.text %>
                    </h3>
                    <p>
                        <%= m.added.toLocaleString('pt-BR', { dateStyle: 'short', timeStyle: 'short' }) %>
                    </p>
                </article>
            </li>
        <% }) %>
    </ul>
    <%- include('form') %>
</body>
</html>